# ============================================================================
# AI Head Node Test Suite - Environment Variables
# ============================================================================
# Copy this file to .env and customize values as needed.
# These environment variables configure test behavior, model selection,
# and workload parameters.
#
# Note: The conftest.py pytest_configure hook and run_workload_acceptance.ps1
#       scripts automatically set sensible defaults for all variables below.
#       Only override if you need non-default behavior.
# ============================================================================

# ============================================================================
# HuggingFace & Large Model Configuration
# ============================================================================

# Enable/disable large model workloads (70B+)
HF_ENABLE_LARGE_MODELS=1

# HuggingFace home directory for model caching
HF_HOME=~/.cache/huggingface

# Allow downloading large models from remote HF hub
HF_ALLOW_REMOTE_LARGE_MODEL_DOWNLOAD=1

# Auto-install missing workload dependencies during preflight
# Linux default behavior is enabled; disable explicitly if needed.
NODE_WORKLOAD_AUTO_INSTALL=1

# Auto-install timeout in seconds
NODE_WORKLOAD_AUTO_INSTALL_TIMEOUT_SEC=1800

# HuggingFace authentication token (for gated models)
# HF_TOKEN=your_token_here

# Model IDs (override to test different models)
HF_LLAMA_7B_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_LLAMA_70B_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
HF_QWEN_70B_MODEL=Qwen/Qwen-72B
HF_DEEPSEEK_R1_QUANT_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_INFERENCE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
HF_TRAINING_MODEL=bert-base-uncased

# Enterprise latency test duration (seconds)
HF_ENTERPRISE_LATENCY_MIN_DURATION_SEC=300

# ============================================================================
# KV Cache Offload Configuration
# ============================================================================

# NOTE:
# These are test-suite knobs consumed by tests/test_node_validation.py.
# They intentionally use NODE_VLLM_* names (not VLLM_*) to avoid vLLM
# warning about unknown environment variables.

# Model to use for KV cache offload test
NODE_VLLM_KV_OFFLOAD_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Context length for KV cache offload (influences KV cache size)
# Examples: 4096, 8192, 16384, 32768
NODE_VLLM_KV_CONTEXT_LENGTH=8192

# Batch size for inference runs
NODE_VLLM_KV_BATCH_SIZE=4

# Number of prompts to generate during test
NODE_VLLM_KV_NUM_PROMPTS=10

# Max tokens to generate per prompt
NODE_VLLM_KV_MAX_TOKENS=512

# Baseline and offload memory-utilization targets used by test harness
NODE_VLLM_BASELINE_GPU_MEMORY_UTIL=0.9

# GPU memory utilization ratio (0.0-1.0)
# Lower values force earlier offload to CPU DDR
NODE_VLLM_GPU_MEMORY_UTIL=0.7

# CPU DDR offload size in GB (enables KV offloading)
NODE_VLLM_CPU_OFFLOAD_GB=128

# ============================================================================
# RDMA / MMIO / DMA Validation Configuration
# ============================================================================

# 2-node RDMA target host for ib_write_lat server endpoint
# RDMA_REMOTE_HOST=10.10.10.2

# RDMA device name (optional, auto-detected from ibv_devices if unset)
# RDMA_DEVICE=mlx5_0

# CUDA device index for perftest --use_cuda
RDMA_USE_CUDA_DEVICE=0

# Iterations for smoke latency run (single-core RDMA test)
RDMA_SMOKE_ITERS=1000

# 4KB average latency pass threshold (microseconds)
RDMA_4KB_MAX_AVG_LAT_US=300.0

# Optional platform-specific commands
# MMIO_VALIDATION_CMD=/opt/tests/mmio_validate
# MMIO_PCI_BDF=af:00.0
# MMIO_ALLOW_WRITE=0
# RDMA_FENCE_VALIDATION_CMD=/opt/tests/rdma_fence_validate

# Soak test controls
RDMA_SOAK_LOOPS=1000
SOAK_MAX_P95_US=20000

# ============================================================================
# Vision Workload Configuration (YOLO)
# ============================================================================

# YOLO model variant
# Options: yolov8n.pt (nano), yolov8s.pt (small), yolov8x.pt (large)
YOLO_DETECT_MODEL=yolov8x.pt

# YOLO inference batch size
YOLO_DETECT_BATCH=128

# Images processed per GPU worker
YOLO_IMAGES_PER_GPU=256

# YOLO image size for inference
YOLO_DETECT_IMGSZ=640

# Use FP16 inference in YOLO workers
YOLO_HALF_PRECISION=1

# GPUs required for the 4-GPU workload
YOLO_GPU_COUNT=4

# YOLO detection source (image URL or local path)
YOLO_DETECT_SOURCE=https://ultralytics.com/images/bus.jpg

# YOLO workload timeout (seconds)
YOLO_DETECT_TIMEOUT_SEC=240

# CPU sampling interval for utilization measurement
YOLO_CPU_SAMPLE_INTERVAL_SEC=0.5

# Target FPS (aggregated across GPUs)
# 4-GPU acceptance target
YOLO_AGGREGATE_FPS_TARGET=200

# Mean host CPU utilization target during YOLO workload
YOLO_CPU_UTIL_TARGET=50

# ============================================================================
# Vision Workload Configuration (Diffusers)
# ============================================================================

# Model for distributed image generation
DIFFUSERS_MODEL_ID=stabilityai/sd-turbo

# Images to generate per GPU rank
DIFFUSERS_NUM_IMAGES=32
DIFFUSERS_IMAGES_PER_GPU=32

# Image height (pixels)
DIFFUSERS_HEIGHT=512

# Image width (pixels)
DIFFUSERS_WIDTH=512

# Inference steps per generated image
DIFFUSERS_STEPS=1

# Guidance scale for generation
DIFFUSERS_GUIDANCE_SCALE=0.0

# Warmup iterations per GPU rank
DIFFUSERS_WARMUP=2

# GPUs required for the distributed workload
DIFFUSERS_GPU_COUNT=4

# NCCL master port for local distributed launch
DIFFUSERS_MASTER_PORT=29501

# Distributed image-generation timeout (seconds)
DIFFUSERS_GENERATE_TIMEOUT_SEC=600

# Aggregate throughput target across all GPUs
DIFFUSERS_TARGET_IMG_PER_SEC=10.0

# ============================================================================
# PyTorch & CUDA Configuration
# ============================================================================

# PyTorch cache directory
TORCH_HOME=~/.cache/torch

# CUDA devices to use (comma-separated indices)
# Example: 0,1,2,3 for 4 GPUs
CUDA_VISIBLE_DEVICES=0,1,2,3

# CUDA device enumeration order
# Use PCI_BUS_ID for consistent ordering across reboots
CUDA_DEVICE_ORDER=PCI_BUS_ID

# ============================================================================
# KPI & Test Configuration
# ============================================================================

# Output path for JSONL KPI records
NODE_VALIDATION_KPI_FILE=artifacts/node_validation_kpis.jsonl

# Shared nvbandwidth root/binary path used by node-validation and performance tests
NVBANDWIDTH_BIN=/root/workloads/nvbandwidth

# Performance-suite command timeout (seconds)
PERF_CMD_TIMEOUT_SEC=1800

# Auto-install missing python deps needed by selected performance cases (Linux default: 1)
PERF_AUTO_INSTALL=1
PERF_AUTO_INSTALL_TIMEOUT_SEC=1800

# Performance-suite KPI output
PERF_SUITE_KPI_FILE=artifacts/performance_suite_kpis.jsonl

# Resolve nvbandwidth automatically from a binary path or source-tree root
PERF_NVBANDWIDTH_BIN=/root/workloads/nvbandwidth

# Resolve nccl-tests binaries used by performance cases 018-025
PERF_NCCL_TESTS_DIR=/root/workloads/nccl-tests/build

# vLLM serve default memory target for large-model performance cases
PERF_VLLM_GPU_MEMORY_UTILIZATION=0.70

# Fallback dtype when a case still specifies unsupported float8 dtype syntax
PERF_VLLM_FP8_DTYPE_FALLBACK=bfloat16

# Override benchmark module path if your vLLM package exposes a different entrypoint
PERF_VLLM_BENCHMARK_MODULE=vllm.benchmarks.benchmark_serving

# Unbuffered Python output (important for live logging)
PYTHONUNBUFFERED=1

# Pytest timeout per test (seconds)
PYTEST_TIMEOUT=600

# ============================================================================
# Usage Examples
# ============================================================================
# Linux runner:
#   chmod +x ./run_workload_acceptance.sh
#   ./run_workload_acceptance.sh
#
#
# Example 1: Run with default settings (Llama-3.1-8B-Instruct, 8K context)
#   pytest -m workload_acceptance -vv tests/test_node_validation.py
#
# Example 2: Test with Llama-3.1-70B-Instruct and 32K context
#   export NODE_VLLM_KV_OFFLOAD_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
#   export NODE_VLLM_KV_CONTEXT_LENGTH=32768
#   export NODE_VLLM_KV_BATCH_SIZE=8
#   pytest -m workload_acceptance -vv tests/test_node_validation.py::TestWorkloadAcceptanceHuggingFace::test_predictable_memory_orchestration_kv_cache_offload
#
# Example 3: Run Bash script with custom KV cache settings
#   ./run_workload_acceptance.sh --kv-context-length 16384 --kv-batch-size 8
#
# Example 4: Test YOLO with smaller model (faster iteration)
#   export YOLO_DETECT_MODEL=yolov8n.pt
#   pytest -m workload_acceptance -vv tests/test_node_validation.py::TestWorkloadAcceptanceHuggingFace::test_vision_object_detection_yolo_fps
#
# Example 5: Skip large models, run quick validation
#   ./run_workload_acceptance.sh --skip-large-models --min-duration-sec 60
