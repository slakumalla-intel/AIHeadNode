            if os.path.exists(pointer_path):
                if dry_run:
                    return DryRunFileInfo(
                        commit_hash=revision,
                        file_size=os.path.getsize(pointer_path),
                        filename=filename,
                        is_cached=True,
                        local_path=pointer_path,
                        will_download=force_download,
                    )
