            repo_id=repo_id,
            filename=filename,
            repo_type=repo_type,
            revision=revision,
            endpoint=endpoint,
            etag_timeout=etag_timeout,
            headers=headers,
            token=token,
            local_files_only=local_files_only,
            storage_folder=storage_folder,
            relative_filename=relative_filename,
        )
    
